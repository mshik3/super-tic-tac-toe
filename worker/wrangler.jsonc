{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "super-tic-tac-toe-worker",
	"main": "src/index.ts",
	"compatibility_date": "2025-09-04",
	"migrations": [
		{
			"new_sqlite_classes": ["GameSession", "MatchmakingQueue"],
			"tag": "v1"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "GameSession",
				"name": "GAME_SESSION"
			},
			{
				"class_name": "MatchmakingQueue",
				"name": "MATCHMAKING_QUEUE"
			}
		]
	},
	"observability": {
		"enabled": true
	},
	"vars": {
		"ALLOWED_ORIGINS": "https://super-tic-tac-toe-76l.pages.dev",
		"ENVIRONMENT": "production"
	}
}
